{
  "name": "fleetops-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:push": "cd packages/db && bunx drizzle-kit push",
    "db:seed": "cd packages/db && bun run seed.ts",
    "api": "cd apps/api && bun --watch src/index.ts",
    "web": "cd apps/web && bun --watch",
    "scraper": "cd apps/scraper && python main.py"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "bun@1.3.11"
}